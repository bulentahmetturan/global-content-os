{
  "name": "global-content-os",
  "private": true,
  "version": "0.1.0",
  "description": "Global Content OS — source monitoring, Global Hub triage, approved_brief handoff to Channel Content OS",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply global-content-os --local",
    "db:remote": "wrangler d1 migrations apply global-content-os --remote",
    "sync:feeds": "node scripts/sync-feeds.mjs",
    "ensure:flow": "node scripts/ensure-complete-flow.mjs",
    "ensure:continuity": "node scripts/ensure-complete-continuity.mjs",
    "close:empty": "node scripts/close-empty-feeds.mjs",
    "flow:continuous": "node scripts/continuous-flow.mjs",
    "typecheck": "tsc --noEmit -p apps/worker/tsconfig.json",
    "ingest:tip": "node adapters/tip-radar/push-to-hub.mjs",
    "production:check": "node scripts/production-check.mjs",
    "generate:hub-assets": "node scripts/generate-hub-assets.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "deploy:identity": "node scripts/deploy-identity.mjs",
    "release:preflight": "node release/preflight.mjs",
    "release:test": "node --test release/test/*.test.mjs",
    "release:smoke": "node release/smoke/smoke.mjs",
    "test:catalog": "vitest run --root packages/source-catalog",
    "typecheck:catalog": "tsc --noEmit -p packages/source-catalog/tsconfig.json",
    "statistics:migration:build": "node scripts/statistics-build-migration.mjs",
    "statistics:migration:check": "node scripts/statistics-build-migration.mjs --check",
    "statistics:schema-proof": "node scripts/statistics-schema-proof.mjs",
    "test:statistics": "node scripts/statistics-test.mjs --engine sqlite",
    "test:statistics:d1": "node scripts/statistics-test.mjs --engine d1",
    "test:statistics:all": "node scripts/statistics-test.mjs",
    "statistics:local-runtime": "node --test apps/worker/src/statistics/local-runtime.test.mjs",
    "statistics:eurostat-profile": "node scripts/statistics-eurostat-profile.mjs",
    "statistics:eurostat-live-smoke": "node scripts/statistics-eurostat-live-smoke.mjs",
    "statistics:capacity-probe": "node scripts/statistics-capacity-probe.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.0",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
