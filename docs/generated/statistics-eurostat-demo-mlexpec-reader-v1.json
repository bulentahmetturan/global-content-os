    ],
    "api_format": "SDMX 2.1 REST with format=JSON → JSON-stat 2.0 (3,347 bytes for 9 series x 3 years); XML not used. Nothing required by the contract was missing from the JSON path (dimensions, values, per-observation flags, updated marker, datastructure version).",
    "bounding": {
      "period": "explicit startPeriod/endPeriod only; lastTimePeriod never sent (asserted by the fixture server on every call)",
      "window": "max 10 years; window-by-window planning helper",
      "dimensions": "sex in {T,M,F}, age in {Y_LT1}, geo in fixed catalog {TR, DE, EU27_2020} (max 8); no wildcard",
      "response": "timeout 8 s, max 262144 bytes, <=10,000 positions",
      "retry": "max 2 retries, exponential backoff 500/1000 ms, only network/timeout/429/5xx"
    },
    "http400": "HTTP 400 INVALID_QUERY_DIMENSION_VALUE on TIME_PERIOD (JSON error body or SOAP-style fault) → SOURCE_PERIOD_OUT_OF_RANGE, run failure_class VALIDATION_FAILURE, never retried, never an empty success; other 400 → SOURCE_BAD_REQUEST (SCHEMA_DRIFT class)",
    "identity": {
      "source": "EUROSTAT_HEALTH (frozen id)",
      "dataset": "EUROSTAT_HEALTH:DEMO_MLEXPEC",
      "indicator": "EUROSTAT_HEALTH:DEMO_MLEXPEC#LIFE_EXPECTANCY",
      "series": "frozen deterministic identity from native dimensions: geography, unit YR, sex, age, extension FREQ and GEO_NATIVE (labels, period, value, release never enter identity)",
      "geography": "native TR/DE/EU27_2020 → ISO3:TUR / ISO3:DEU / AGG:EU27_2020; native code, canonical code and source label persisted as the GEO_NATIVE extension dimension"
    },
    "release_model": "release_key = updated:<UTC-normalized source marker>; raw marker kept as source_native_release_id; same marker → same release (never a new one per retrieval); new marker → new immutable release superseding the previous; invalid/implausible marker → SOURCE_INVALID_UPDATE_MARKER",
    "value_mapping": "number → PRESENT with numeric and verbatim text (JSON loses trailing zeros, e.g. 79.0 arrives as 79: documented limitation); absent position → MISSING with NULL numeric (never 0); status flag preserved verbatim (b, e, p, combinations); p ⇒ PROVISIONAL, otherwise finality stays UNKNOWN (never inferred FINAL)",
    "checkpoint": "unit_kind API_STAMP; scope DEMO_MLEXPEC|age|sex|geo|window; last_source_stamp = raw updated; last_content_fingerprint; cursor after=<year|geo|sex|age> then complete:year=<end>; advanced only inside the lease-guarded write batch",
    "provenance": "locator sdmx:DEMO_MLEXPEC/<key>@<year>; artifact req_<sha256(request descriptor | response digest)>, EXTERNAL_REPRODUCIBLE, reproducibility locator = the exact bounded GET URL, no response bytes in D1; reader/parser version on the run",
    "lease_guard": "every write batch carries the checkpoint advance; leaseGuard NONE appears nowhere in reader code (asserted)"
  },
