{
  "$comment": "CANONICAL vocabulary for EVERGREEN > DOSSIER_DISCOVERY (architecture foundation, non-production). Owner: global-content-os/packages/contracts. This file defines CLASSES and CONTRACT SHAPES only. It never lists real-world topics, supplements, protocols, technologies, conditions, experts or relations: concept membership is OPEN-WORLD runtime data that arrives as observations and becomes human-reviewed proposals. No migration, reader, scheduler or source activation exists for this contract yet. Doc: docs/DOSSIER-DISCOVERY.md.",
  "version": 1,
  "contract": "evergreen-dossier-discovery",

  "temporal": {
    "parent_path": "EVERGREEN",
    "subsystem": "DOSSIER_DISCOVERY",
    "candidate_temporal_identity": "EVERGREEN",
    "own_temporal_path": false,
    "own_acquisition_path": false,
    "is_evergreen_view": false,
    "writes_source_items": false,
    "signal_freshness_is_not_candidate_identity": true,
    "reuses_existing_items_as_sensors": true,
    "routing": {
      "single_acute_event": "TIME_SENSITIVE (existing path, unchanged)",
      "repeated_or_structural_pattern": "EVERGREEN > DOSSIER_DISCOVERY",
      "global_emerging_issue_with_health_significance": "EVERGREEN > DOSSIER_DISCOVERY (FRONTIER)"
    },
    "signal_windows": { "7D": "burst", "30D": "momentum", "90D": "baseline" }
  },

  "open_world": {
    "classes_are_bounded": true,
    "concept_membership_is_open": true,
    "unknown_policy": "PROPOSAL",
    "resolution_outcomes": ["MATCHED_EXISTING", "PROPOSED"],
    "forbidden_resolution_outcomes": ["DROPPED", "AUTO_CANONICAL", "REJECTED_AS_UNKNOWN"],
    "concept_states": ["PROPOSED", "ACTIVE", "REJECTED", "PAUSED"],
    "proposal_families": [
      "NEW_HEALTH_TOPIC",
      "NEW_PROTOCOL",
      "NEW_SUPPLEMENT",
      "NEW_SUPPLEMENT_FORM",
      "NEW_LONGEVITY_TECH",
      "NEW_PUBLIC_HEALTH_TOPIC",
      "NEW_EXPERT",
      "NEW_RELATION"
    ]
  },

  "domains": {
    "HEALTH": {
      "proposal_family": "NEW_HEALTH_TOPIC",
      "concept_classes": ["DISEASE_CONDITION", "SYMPTOM", "PHYSIOLOGY", "DIAGNOSTIC", "TREATMENT", "MEDICATION", "EXPOSURE", "RISK_FACTOR", "BEHAVIOR_LIFESTYLE", "BIOMARKER", "INTERVENTION"]
    },
    "NUTRITION_PROTOCOL": {
      "proposal_family": "NEW_PROTOCOL",
      "concept_classes": ["FASTING", "MEAL_TIMING", "CARBOHYDRATE_RESTRICTION", "ELIMINATION", "GI_PROTOCOL", "DIETARY_PATTERN", "NAMED_PROTOCOL", "OTHER"],
      "is_health_alias": false
    },
    "SUPPLEMENT": {
      "proposal_family": "NEW_SUPPLEMENT",
      "child_proposal_family": "NEW_SUPPLEMENT_FORM",
      "concept_classes": ["SUPPLEMENT", "SUPPLEMENT_FORM"],
      "is_knowledge_engine": false,
      "form_claims_forbidden": ["BETTER", "SAFER", "MORE_BIOAVAILABLE", "CONDITION_SPECIFIC_USEFULNESS"]
    },
    "LONGEVITY_TECHNOLOGY": {
      "proposal_family": "NEW_LONGEVITY_TECH",
      "concept_classes": ["MEASUREMENT", "DIAGNOSTIC", "DIGITAL_MONITORING", "THERAPEUTIC_PLATFORM", "DRUG_PLATFORM", "REGENERATIVE", "GENE_TECH", "CELLULAR_TECH", "OMICS", "DEVICE", "CONSUMER_TECH"]
    },
    "POPULATION_ENVIRONMENTAL_PUBLIC_HEALTH": {
      "proposal_family": "NEW_PUBLIC_HEALTH_TOPIC",
      "discovery_lanes": ["TURKEY_REALITY", "GLOBAL_PUBLIC_HEALTH_FRONTIER", "TRANSNATIONAL_HEALTH"],
      "concept_classes": ["AIR_QUALITY", "WATER", "CLIMATE_HEALTH", "FOOD_SAFETY", "ENVIRONMENTAL_EXPOSURE", "PUBLIC_HEALTH_SURVEILLANCE", "ANTIMICROBIAL_RESISTANCE", "VECTOR_ONE_HEALTH", "POPULATION_RISK_BEHAVIOR"],
      "water_facets": ["DRINKING_WATER_ACCESS", "DRINKING_WATER_QUALITY", "WATER_TREATMENT", "WATER_SECURITY_SCARCITY", "WASTEWATER", "BATHING_WATER", "WATER_CONTAMINANTS"],
      "turkey_specific_data_may_be_unknown": true,
      "health_consequence_must_be_central": true
    }
  },

  "signal": {
    "families": [
      "TURKEY_PUBLIC_DEMAND",
      "TURKEY_SOCIAL_MOMENTUM",
      "TR_CLINICIAN_CREATOR_PULSE",
      "TURKEY_HEALTH_BURDEN",
      "TURKEY_PUBLIC_HEALTH_DATA",
      "ENVIRONMENTAL_MEASUREMENT",
      "GLOBAL_MEDICAL_FRONTIER",
      "GLOBAL_RESEARCH_ACTIVITY",
      "GLOBAL_INSTITUTIONAL_FRONTIER",
      "GLOBAL_PUBLIC_HEALTH_DATA",
      "GLOBAL_ENVIRONMENTAL_OBSERVATION",
      "GLOBAL_CREATOR_SCOUT",
      "RELATION_SIGNAL"
    ],
    "families_are_never_collapsed_into_one_score": true,
    "value_states": ["MEASURED", "UNKNOWN", "NOT_APPLICABLE"],
    "missing_value_state": "UNKNOWN",
    "unknown_is_never_zero": true,
    "frontier_is_not_a_person_list": true,
    "frontier_derives_from": ["research_activity", "trial_activity", "major_institutions", "researcher_topic_activity", "guideline_consensus_activity"],
    "persons_are_provenance_not_editorial_subject": true,
    "measurement_provenance": ["MEASURED", "MODELED", "ADMINISTRATIVE", "SURVEY", "ESTIMATE", "ALERT", "CONTENT", "SEARCH", "SOCIAL"],
    "measured_equals_modeled": false
  },

  "observation": {
    "source_item_is_not_observation": true,
    "one_source_item_may_yield_many_observations": true,
    "kinds": [
      "CONTENT_MENTION",
      "SEARCH_MAGNITUDE",
      "SEARCH_VELOCITY",
      "SOCIAL_MOMENTUM",
      "BURDEN_UTILIZATION",
      "ADMINISTRATIVE_STATISTIC",
      "SURVEY_ESTIMATE",
      "ENVIRONMENTAL_MEASURED",
      "ENVIRONMENTAL_MODELED",
      "SURVEILLANCE_CHANGE",
      "RESEARCH_ACTIVITY_COUNT",
      "INSTITUTIONAL_TOPIC_ACTIVITY"
    ],
    "required_fields": ["observation_id", "kind", "signal_family", "measurement_provenance", "observed_at", "origin"],
    "origin_kinds": ["EXISTING_SOURCE_ITEM", "SIGNAL_SNAPSHOT", "STATISTICAL_RELEASE"],
    "concept_ref": { "exactly_one_of": ["concept_id", "unresolved_label"] },
    "clinician_reported_public_question_is_not_prevalence": true
  },

  "source": {
    "roles": ["ACADEMIC_SCIENTIST", "CLINICIAN_RESEARCHER", "CLINICIAN_CREATOR", "HEALTH_CREATOR", "FUNCTIONAL_INTEGRATIVE_CREATOR", "PHARMACIST_CREATOR", "INSTITUTION"],
    "roles_must_stay_distinguishable": true,
    "raw_mention_count_may_not_outweigh_academic_or_institutional_signal": true,
    "content_classes": {
      "discovery_eligible": ["HEALTH_EDUCATIONAL", "PATIENT_QUESTION", "CLINICAL_OBSERVATION", "RESEARCH_COMMENTARY"],
      "non_discovery": ["PERSONAL", "PROMOTIONAL", "SPONSORED", "OWN_PRODUCT", "OWN_SERVICE", "AFFILIATE", "UNKNOWN"]
    },
    "commercial_context": ["NONE", "SPONSORED", "AFFILIATE", "OWN_PRODUCT", "OWN_SERVICE", "BRAND_PARTNERSHIP", "UNKNOWN"],
    "access_states": ["APPROVED", "RESTRICTED", "MANUAL_ONLY", "UNRESOLVED", "REJECTED"],
    "only_approved_may_be_read_by_a_future_reader": true,
    "authority_scores_assigned_by_contract": false,
    "credentials_invented_by_contract": false
  },

  "relation": {
    "allowed_semantics": ["CO_INTEREST", "MENTIONED_WITH", "PUBLIC_SEARCH_ASSOCIATION", "CREATOR_ASSOCIATION", "FRONTIER_ASSOCIATION", "ENVIRONMENTAL_ASSOCIATION"],
    "forbidden_semantics": ["CAUSES", "CURES", "TREATS", "IMPROVES", "PREVENTS"],
    "depth_labels": { "1": "SINGLE", "2": "DOUBLE", "3": "TRIPLE", "4+": "COMPOSITE" },
    "auto_generation_max_depth": 3,
    "pair": {
      "individual_popularity_implies_pair": false,
      "requires_joint_signal": true,
      "joint_signal_kinds": ["JOINT_SEARCH", "JOINT_SOURCE_MENTION", "TITLE_OR_CAPTION_CO_OCCURRENCE", "RELATED_QUERY_RELATIONSHIP", "DIRECT_RELATION_OBSERVATION"]
    },
    "triple": {
      "arbitrary_combination_allowed": false,
      "requires_one_of": ["DIRECT_TRIPLE_SIGNAL", "SUPPORTED_PAIR_NETWORK"],
      "supported_pair_network_minimum": { "supporting_pairs": 3, "independent_signal_families": 2 }
    }
  },

  "quality": {
    "is_signal_hygiene_not_medical_evidence_grading": true,
    "never_reduced_to_one_opaque_score": true,
    "dimensions": {
      "independence": ["SIGNAL_DIVERSITY", "SOURCE_QUALITY", "CREATOR_DIVERSITY", "PLATFORM_DIVERSITY", "PERSISTENCE"],
      "integrity": ["COMMERCIAL_PRESSURE", "HYPE_RISK", "TOPIC_COHERENCE", "RELATION_INTEGRITY", "SENSATIONALISM_RISK"],
      "relevance": ["TURKEY_RELEVANCE", "GLOBAL_SIGNIFICANCE", "AUDIENCE_RELEVANCE"],
      "data": ["DATA_STRENGTH", "GEOGRAPHIC_SPREAD"]
    },
    "independence_counters": ["mention_count", "unique_creator_count", "unique_platform_count", "independent_signal_family_count"],
    "origin_cluster_required": true,
    "commercial_pressure_may_downgrade_but_not_suppress_corrective": true,
    "reason_codes": ["NO_INDEPENDENT_SIGNAL", "SINGLE_ORIGIN_CLUSTER", "COMMERCIAL_CONTEXT", "HYPE_PATTERN", "LOW_TOPIC_COHERENCE", "UNSUPPORTED_RELATION", "TURKEY_DATA_UNKNOWN", "LOW_PERSISTENCE", "INSUFFICIENT_SIGNAL_DIVERSITY"]
  },

  "wow": {
    "wow_is_not_viral": true,
    "definition": ["SURPRISING", "IMPORTANT", "DATA_SUPPORTABLE", "RESEARCHABLE", "MEANINGFUL_TO_PEOPLE"],
    "pattern_classes": ["SURPRISING_BASELINE", "CROSS_COUNTRY_GAP", "RAPID_CHANGE", "HIDDEN_EXPOSURE", "SPATIAL_INEQUALITY", "BEHAVIOR_SURPRISE", "SYSTEM_SURPRISE", "ONE_HEALTH_SIGNAL", "FRONTIER_IMPORT", "SCALE_SHOCK", "GLOBAL_SHIFT", "SCIENCE_TO_PUBLIC_HEALTH", "EVERYDAY_SYSTEM"],
    "dimensions": ["SURPRISE", "PUBLIC_REACH", "TURKEY_RELEVANCE", "GLOBAL_SIGNIFICANCE", "AUDIENCE_RELEVANCE", "DATA_STRENGTH", "CONTRAST", "NOVELTY", "PERSONAL_PROXIMITY", "VISUALIZABILITY", "FRONTIER_VALUE", "SENSATIONALISM_RISK"],
    "applies_to_domain": "POPULATION_ENVIRONMENTAL_PUBLIC_HEALTH",
    "data_surveillance_driven_social_is_context_only": true
  },

  "candidate": {
    "classes": ["STRONG", "EMERGING", "WATCH", "CORRECTIVE", "FRONTIER"],
    "classes_are_discovery_states_not_scientific_labels": true,
    "corrective_means_research_carefully_not_false": true,
    "states": ["DISCOVERED", "WATCH", "CANDIDATE", "REVIEW", "ACCEPTED", "REJECTED", "SNOOZED", "RESEARCH_REQUESTED"],
    "terminal_state_of_discovery": "RESEARCH_REQUESTED",
    "topic_relevance_and_signal_freshness_are_separate": true,
    "why_now_snapshot": { "required": true, "immutable_once_written": true, "fields": ["snapshot_at", "signal_windows", "signal_families", "origin_cluster_ids", "observation_ids"] }
  },

  "review": {
    "decisions": ["ACCEPT", "REJECT", "SNOOZE"],
    "reject_reasons": ["NOISE", "DUPLICATE", "TOO_BROAD", "TOO_NARROW", "COMMERCIAL_ARTIFACT", "NO_AUDIENCE_RELEVANCE", "NO_INDEPENDENT_SIGNAL", "RELATION_NOT_SUPPORTED", "OUT_OF_SCOPE"],
    "reject_requires_reason": true,
    "rejections_persist": ["topic", "expert", "relation"],
    "decider": "HUMAN",
    "review_may_mutate": [],
    "review_may_never_mutate": ["signal_weights", "source_activation", "source_cadence", "canonical_registry", "routing"]
  },

  "handoff": {
    "starts_after": "ACCEPT",
    "allowed_fields": ["canonical_topic", "domain", "aliases", "relation_depth", "why_now", "signal_family_summary", "public_questions", "related_concepts", "discovery_provenance", "quality_reason_codes"],
    "forbidden_fields": ["scientific_conclusion", "literature_synthesis", "treatment_advice", "dose", "dosage", "efficacy_verdict", "safety_verdict", "myth_verdict", "personal_attribution_as_subject"],
    "auto_publish": false
  },

  "boundary": {
    "chain": ["SIGNAL_SOURCE_ITEM", "OBSERVATION", "CONCEPT", "RELATION", "CANDIDATE", "REVIEW", "RESEARCH_HANDOFF"],
    "dossier_entities_live_in_source_items": false,
    "discovery_is_research": false
  },

  "privacy": {
    "forbidden_inference": ["patient_identity", "commenter_disease_status", "commenter_personal_location_for_health_inference", "individual_medical_status"],
    "public_professional_creators_may_be_source_entities": true
  },

  "reader_status": {
    "fields": ["source_id", "operational_state", "access_state", "last_fetch", "last_error", "cursor", "lease", "underfill", "next_due", "observations_total", "proposals_open"],
    "mirrors": "GET /api/evergreen/status per-source shape",
    "live_readers": 0
  }
}
