    { "id": "handoff_failure", "repo": "gcos", "pattern": "handoff_log", "file": "apps/worker/src/index.ts" },
    { "id": "callback_failure", "repo": "ccos", "pattern": "callback_last_error", "file": "mcp-server/src/handoff/approved-brief.ts" },
    { "id": "production_job_failure", "repo": "ccos", "pattern": "failed", "file": "mcp-server/src/handoff/approved-brief.ts" },
