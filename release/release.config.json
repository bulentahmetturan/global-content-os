{
  "$comment": "P7 readiness config (bound at final reconciliation). Paths/names only -- never secret values.",
  "repos": {
    "gcos": {
      "wrangler": "wrangler.toml",
      "migrationsDir": "migrations",
      "healthPath": "/api/health"
    },
    "ccos": {
      "candidates": [
        "../channel-content-os",
        "../../channel-content-os"
      ],
      "marker": "mcp-server/wrangler.toml",
      "wrangler": "mcp-server/wrangler.toml",
      "schema": "mcp-server/src/db/schema.sql",
      "migrationsDir": "mcp-server/src/db/migrations"
    }
  },
  "expectedBranches": {
    "gcos": "final/system-v1-reconciliation",
    "ccos": "final/system-v1-reconciliation"
  },
  "pendingMigrations": {
    "ccos": [
      "040_approved_brief_intake.sql"
    ],
    "gcos": []
  },
  "secrets": {
    "gcos": [
      {
        "name": "CCOS_HANDOFF_URL",
        "purpose": "outbound handoff URL",
        "requiredFor": "cutover"
      },
      {
        "name": "CCOS_HANDOFF_TOKEN",
        "purpose": "outbound handoff bearer",
        "requiredFor": "cutover"
      },
      {
        "name": "STATUS_CALLBACK_TOKEN",
        "purpose": "inbound status callback bearer",
        "requiredFor": "cutover"
      },
      {
        "name": "TIP_RADAR_INGEST_TOKEN",
        "purpose": "source ingress bearer",
        "requiredFor": "always"
      }
    ],
    "ccos": [
      {
        "name": "HANDOFF_INGEST_TOKEN",
        "purpose": "inbound approved_brief bearer",
        "requiredFor": "cutover"
      },
      {
        "name": "GCOS_STATUS_TOKEN",
        "purpose": "outbound status callback bearer",
        "requiredFor": "cutover"
      },
      {
        "name": "MCP_AUTH_TOKEN",
        "purpose": "MCP legacy bearer (preview)",
        "requiredFor": "optional"
      }
    ]
  },
  "vars": {
    "ccos": [
      {
        "name": "GCOS_STATUS_URL",
        "requiredFor": "cutover"
      }
    ]
  },
  "failClosedEvidence": [
    {
      "repo": "ccos",
      "file": "mcp-server/src/handoff/approved-brief.ts",
      "pattern": "handoff_not_configured",
      "desc": "CCOS ingest disabled (503) when HANDOFF_INGEST_TOKEN unset"
    },
    {
      "repo": "ccos",
      "file": "mcp-server/src/handoff/handoff.test.ts",
      "pattern": "handoff_not_configured",
      "desc": "fail-closed covered by CCOS tests"
    },
    {
      "repo": "gcos",
      "file": "apps/worker/src/index.ts",
      "pattern": "authorizeToken\\(env\\.STATUS_CALLBACK_TOKEN",
      "desc": "GCOS status callback fails closed (503 when secret unset)"
    },
    {
      "repo": "gcos",
      "file": "apps/worker/src/index.ts",
      "pattern": "authorizeToken\\(env\\.TIP_RADAR_INGEST_TOKEN",
      "desc": "GCOS tip ingest fails closed (503 when secret unset)"
    },
    {
      "repo": "gcos",
      "file": "apps/worker/src/handoff-security.ts",
      "pattern": "CCOS_HANDOFF_TOKEN_NOT_CONFIGURED",
      "desc": "live outbound handoff never sends unauthenticated"
    }
  ],
  "contracts": {
    "canonical": {
      "repo": "gcos",
      "file": "packages/contracts/approved-brief.schema.json"
    },
    "copy": {
      "repo": "ccos",
      "file": "mcp-server/src/handoff/contract/approved-brief.schema.json"
    }
  },
  "observabilitySignals": [
    {
      "id": "fetch_failure",
      "repo": "gcos",
      "pattern": "last_fetched_at|fetch_error|feed_fetch",
      "file": "apps/worker/src/index.ts"
    },
    {
      "id": "handoff_failure",
      "repo": "gcos",
      "pattern": "handoff_log",
      "file": "apps/worker/src/triage/actions.ts"
    },
    {
      "id": "readiness_endpoint",
      "repo": "gcos",
      "pattern": "/api/ready",
      "file": "apps/worker/src/index.ts"
    },
    {
      "id": "scheduler_capacity_delay",
      "repo": "gcos",
      "pattern": "CAPACITY_DELAY",
      "file": "adapters/hekimler-radar/radar/hekimler_scheduler.py"
    },
    {
      "id": "scheduler_attention",
      "repo": "gcos",
      "pattern": "attention_conditions",
      "file": "adapters/hekimler-radar/radar/hekimler_scheduler.py"
    },
    {
      "id": "scheduler_state_report",
      "repo": "gcos",
      "pattern": "scheduler-state\\.json",
      "file": "adapters/hekimler-radar/scripts/hekimler_scheduled_run.py"
    },
    {
      "id": "callback_failure",
      "repo": "ccos",
      "pattern": "callback_last_error",
      "file": "mcp-server/src/handoff/approved-brief.ts"
    },
    {
      "id": "production_job_failure",
      "repo": "ccos",
      "pattern": "failed",
      "file": "mcp-server/src/handoff/approved-brief.ts"
    },
    {
      "id": "auth_config_failure",
      "repo": "ccos",
      "pattern": "handoff_not_configured",
      "file": "mcp-server/src/handoff/approved-brief.ts"
    }
  ],
  "tests": {
    "gcos": [
      {
        "id": "gcos-worker-security",
        "cmd": "node --test apps/worker/src/handoff-security.test.mjs apps/worker/src/handoff-status.test.mjs apps/worker/src/readiness.test.mjs apps/worker/src/scheduled-jobs.test.mjs"
      },
      {
        "id": "gcos-ops-invariants",
        "cmd": "node --test scripts/ops-invariants.test.mjs scripts/registry-find.test.mjs scripts/source-actions.test.mjs"
      },
      {
        "id": "gcos-scheduler-sim",
        "cmd": "python -m pytest tests/test_hekimler_scheduler_fairness.py tests/test_hekimler_scheduler.py -q",
        "cwd": "adapters/hekimler-radar"
      },
      {
        "id": "gcos-router",
        "cmd": "node scripts/check-router-links.mjs"
      }
    ],
    "ccos": [
      {
        "id": "ccos-typecheck",
        "cmd": "npx tsc --noEmit",
        "cwd": "mcp-server"
      },
      {
        "id": "ccos-handoff-auth",
        "cmd": "npx vitest run src/handoff src/auth src/feedback",
        "cwd": "mcp-server"
      },
      {
        "id": "ccos-feedback-package",
        "cmd": "node --test src/feedback.test.mjs",
        "cwd": "packages/feedback"
      },
      {
        "id": "ccos-router",
        "cmd": "node scripts/check-router-links.mjs"
      }
    ]
  },
  "deferred": {
    "P2": "none -- canonical contract at packages/contracts, catalog at packages/source-catalog (bound)",
    "P3": "none -- CCOS release branch bound",
    "P4": "none -- router checked by the gcos-router / ccos-router tests",
    "P5": "none -- guarantees in docs/OPERATIONS.md, signals bound in bindings.json",
    "P6": "persistent feedback adapter/endpoint needs an applied migration (out of scope until cutover authorization)"
  }
}
