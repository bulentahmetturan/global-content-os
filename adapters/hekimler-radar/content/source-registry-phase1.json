  "global_rules": {
    "preserve_official_url": true,
    "fetch_methods_allowed": [
      "rss",
      "api",
      "list-page",
      "page-parser",
      "pdf-follow"
    ],
    "fetch_methods_forbidden": [
      "generic-web-search",
      "insecure-tls",
      "undocumented-spa-api"
    ],
    "ai_may": [
      "classify",
      "extract",
      "summarize"
    ],
    "ai_must_not": [
      "infer missing dates",
      "infer eligibility",
      "infer legal effect",
      "infer causal claims",
      "infer medical implications not stated or clearly supported"
    ],
    "candidate_routes": [
      "OPPORTUNITY",
      "CAREER",
      "EDUCATION",
      "PROFESSIONAL_BRIEF",
      "PUBLIC_HEALTH",
      "DATA_INSIGHT",
      "NEEDS_REVIEW",
      "DISCARD"
    ],
    "low_viral_signal_must_not_penalize": [
      "OPPORTUNITY",
      "CAREER",
      "EDUCATION",
      "PROFESSIONAL_BRIEF",
      "PUBLIC_HEALTH",
      "DATA_INSIGHT"
    ],
    "feed_eligibility": "Requires both high medical relevance and an evidence-complete source; Phase 1 does not auto-route to FEED.",
    "strict_medical_only": "Items with no include_keyword hit and/or an exclude_keyword hit are DISCARD. Unclear medical impact → NEEDS_REVIEW, never FEED.",
    "tls_verification_required": true,
    "never_disable_tls": true,
    "queue_wiring": "disabled_until_fetch_fixtures_pass",
    "auto_publish": false,
    "editorial_review_mandatory": true,
    "source_health_states": [
      "HEALTHY",
      "NO_CHANGE",
      "DEGRADED",
      "MANUAL_REVIEW_REQUIRED",
      "DISABLED"
    ],
    "congress_discard": true,
    "pipeline_wiring_enabled": true,
    "congress_features_active": false,
    "continuous_ingestion_v1": true
  },
