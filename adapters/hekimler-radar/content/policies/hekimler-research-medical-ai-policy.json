  "watch_only_study_designs": [
    "case_series",
    "case_report",
    "in_vitro",
    "animal_study",
    "modeling_study"
  ],
  "language_guardrails": {
    "must_answer": [
      "What was studied?",
      "In whom or in what setting?",
      "What was found?",
      "What does this not prove?",
      "Does this change clinical practice now?",
      "Why should a medical student or physician care?"
    ],
    "banned_hype_unless_editorial_justified": [
      "breakthrough",
      "cure",
      "revolutionary"
    ]
  }
